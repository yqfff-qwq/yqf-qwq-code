{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build-auto",
            "group": "build",

            "windows": {
                "command": "g++",
                "args": [
                    "-std=c++11",
                    "-g",
                    "${file}",
                    "-o",
                    "${fileDirname}/${fileBasenameNoExtension}.exe"
                ]
            },
            "linux": {
                "command": "g++",
                "args": [
                    "-std=c++11",
                    "-g",
                    "${file}",
                    "-o",
                    "${fileDirname}/${fileBasenameNoExtension}"
                ]
            },
            "problemMatcher": []
        }
    ]
}
